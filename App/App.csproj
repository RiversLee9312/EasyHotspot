<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><OutputType>WinExe</OutputType><AssemblyName>EasyHotspot</AssemblyName><RootNamespace>EasyHotspot</RootNamespace><UseWinUI>true</UseWinUI><WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>true</SelfContained><RuntimeIdentifier>win-x64</RuntimeIdentifier><Platforms>x64</Platforms><PlatformTarget>x64</PlatformTarget><DefaultLanguage>en-US</DefaultLanguage><ApplicationManifest>app.manifest</ApplicationManifest><PublishTrimmed>false</PublishTrimmed></PropertyGroup>
